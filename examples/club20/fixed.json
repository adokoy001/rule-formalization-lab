      "when": {
        "op": "lt",
        "args": [
          {
            "var": "age"
          },
          {
            "const": 16
          }
        ]
      },
      "then": {
        "output": "loan_limit",
        "value": 0
      },
      "overrides": [
        "R09",
        "R10"
      ]
    },
