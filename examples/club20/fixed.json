      "when": {
        "op": "and",
        "args": [
          {
            "op": "lt",
            "args": [
              {
                "var": "age"
              },
              {
                "const": 16
              }
            ]
          },
          {
            "var": "event"
          },
          {
            "var": "training"
          }
        ]
      },
      "then": {
        "output": "loan_limit",
        "value": 3
      },
      "overrides": [
        "R11"
      ]
    },
    {
      "id": "R13",
      "source": "第13条　25歳以上の既存会員の貸出上限は、第9条及び第10条にかかわらず2個とする。",
      "when": {
        "op": "and",
        "args": [
