        "output": "badge",
        "value": true
      },
      "overrides": []
    },
    {
      "id": "R09",
      "source": "第9条　機材講習を修了した参加者の貸出上限は、3個とする。",
      "when": {
        "var": "training"
      },
      "then": {
        "output": "loan_limit",
        "value": 3
      },
      "overrides": []
    },
    {
      "id": "R10",
      "source": "第10条　機材講習を修了していない参加者の貸出上限は、1個とする。",
      "when": {
        "op": "not",
        "args": [
          {
            "var": "training"
          }
        ]
      },
      "then": {
        "output": "loan_limit",
        "value": 1
      },
      "overrides": []
    },
    {
      "id": "R11",
