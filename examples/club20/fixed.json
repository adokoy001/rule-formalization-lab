    },
    {
      "id": "R17",
      "source": "第17条　特別企画に参加する、既存会員ではない学生の預り金は、第16条にかかわらず1000円とする。",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "not",
            "args": [
              {
                "var": "member"
              }
            ]
          },
          {
            "var": "student"
          },
          {
