{
  "profile": "finite-decisions/1",
  "origin_kind": "authored_core",
  "title": "星見クラブ20規則 — 境界と貸出例外を直した版",
  "inputs": {
    "age": {
      "kind": "int",
      "min": 0,
      "max": 25
    },
    "event": {
      "kind": "bool"
    },
    "member": {
      "kind": "bool"
    },
    "student": {
      "kind": "bool"
    },
    "training": {
      "kind": "bool"
    }
  },
  "outputs": {
    "eligible": {
      "type": {
        "kind": "bool"
      },
      "required": true
    },
    "fee_yen": {
      "type": {
        "kind": "int",
        "min": 0,
        "max": 1000
      },
      "required": true
    },
    "loan_limit": {
      "type": {
        "kind": "int",
        "min": 0,
        "max": 3
      },
      "required": true
    },
    "deposit_yen": {
      "type": {
        "kind": "int",
        "min": 0,
        "max": 1000
      },
      "required": true
    },
    "handbook": {
      "type": {
        "kind": "enum",
        "values": [
          "digital",
          "paper"
        ]
      },
      "required": true
    },
    "badge": {
      "type": {
        "kind": "bool"
      },
      "required": false
    }
  },
  "constraints": [],
  "facts": [],
  "rules": [
    {
      "id": "R01",
      "source": "第1条　18歳以上の参加者は、会員資格を持つ。",
      "when": {
        "op": "ge",
        "args": [
          {
            "var": "age"
          },
          {
            "const": 18
          }
        ]
      },
      "then": {
        "output": "eligible",
        "value": true
      },
      "overrides": []
    },
    {
      "id": "R02",
      "source": "第2条　18歳未満の参加者は、会員資格を持たない。",
      "when": {
        "op": "lt",
        "args": [
          {
            "var": "age"
          },
          {
            "const": 18
          }
        ]
      },
      "then": {
        "output": "eligible",
        "value": false
      },
      "overrides": []
    },
    {
      "id": "R03",
      "source": "第3条　18歳未満の参加者の参加料金は、500円とする。",
      "when": {
        "op": "lt",
        "args": [
          {
            "var": "age"
          },
          {
            "const": 18
          }
        ]
      },
      "then": {
        "output": "fee_yen",
        "value": 500
      },
      "overrides": []
    },
    {
      "id": "R04",
      "source": "第4条　18歳以上の参加者の参加料金は、1000円とする。",
      "when": {
        "op": "ge",
        "args": [
          {
            "var": "age"
          },
          {
            "const": 18
          }
        ]
      },
      "then": {
        "output": "fee_yen",
        "value": 1000
      },
      "overrides": []
    },
    {
      "id": "R05",
      "source": "第5条　18歳以上の学生の参加料金は、第4条にかかわらず800円とする。",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "ge",
            "args": [
              {
                "var": "age"
              },
              {
                "const": 18
              }
            ]
          },
          {
            "var": "student"
          }
        ]
      },
      "then": {
        "output": "fee_yen",
        "value": 800
      },
      "overrides": [
        "R04"
      ]
    },
    {
      "id": "R06",
      "source": "第6条　特別企画に参加する18歳以上の学生の参加料金は、第5条にかかわらず1000円とする。",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "ge",
            "args": [
              {
                "var": "age"
              },
              {
                "const": 18
              }
            ]
          },
          {
            "var": "student"
          },
          {
            "var": "event"
          }
        ]
      },
      "then": {
        "output": "fee_yen",
        "value": 1000
      },
      "overrides": [
        "R05"
      ]
    },
    {
      "id": "R07",
      "source": "第7条　18歳以上の学生には、記念バッジの配布対象印を付ける。",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "ge",
            "args": [
              {
                "var": "age"
              },
              {
                "const": 18
              }
            ]
          },
          {
            "var": "student"
          }
        ]
      },
      "then": {
        "output": "badge",
        "value": true
      },
      "overrides": []
    },
    {
